                "en": "A pavilion in the mist, travertine terraces and water among the trees."
              }
            },
            {
              "imageId": "img-6039",
              "shape": "square"
            }
          ]
        },
        {
          "id": "block-010",
          "type": "gallery",
          "layout": "two",
          "images": [
            {
