          "images": [
            {
              "imageId": "water-town-mural",
              "caption": {
                "zh": "白墙、黛瓦、水巷——旅程先从一幅江南画面开始",
                "en": "White walls, dark tiles, and canals — the trip began with a Jiangnan scene"
